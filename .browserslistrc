# Browsers the build targets for JS and CSS output (esbuild and autoprefixer).
# This is Angular 21's browser support policy, "baseline widely available" on the date in
# node_modules/@angular/build/src/utils/supported-browsers.js; browsers outside it are ignored by the
# build with a warning, so raise these minimums together with Angular majors.
#
# To list the browsers these queries select: npx browserslist

Chrome >= 111
ChromeAndroid >= 111
Edge >= 111
Firefox >= 112
FirefoxAndroid >= 112
Safari >= 16.4
iOS >= 16.4
