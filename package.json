{
  "name": "kamu-platform",
  "version": "0.71.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --watch",
    "start:no-watch": "ng serve --watch=false",
    "build": "ng build",
    "build:stats": "ng build --stats-json",
    "build-prod": "ng build --configuration production",
    "build-prod:stats": "ng build --configuration production --stats-json",
    "analyze": "webpack-bundle-analyzer dist/kamu-platform/stats.json",
    "test": "ng test --no-progress --no-watch --browsers ChromeHeadless --code-coverage",
    "test-firefox": "ng test --no-progress --browsers Firefox --code-coverage",
    "lint": "eslint .",
    "lint-and-fix": "eslint . --fix",
    "lint-harness": "python3 -m unittest discover -s scripts/agents/tests -t .",
    "stylelint": "stylelint '**/*.scss'",
    "stylelint:windows": "stylelint \"**/*.scss\"",
    "stylelint-fix": "stylelint '**/*.scss' --fix",
    "prettier": "prettier --write '**/*.{ts,scss,js,html,spec.ts}'",
    "prettier-check": "prettier --check '**/*.{ts,scss,js,html,spec.ts}'",
    "gql-update-schema": "curl https://raw.githubusercontent.com/kamu-data/kamu-cli/master/resources/schema.gql > resources/schema.graphql",
    "gql-codegen": "graphql-codegen --config gql-codegen.yml",
    "release-patch": "npm version patch -m \"Release v%s\"",
    "release-minor": "npm version minor -m \"Release v%s\"",
    "release-major": "npm version major -m \"Release v%s\"",
    "version": "node update-changelog.js && git add CHANGELOG.md LICENSE.txt",
    "prebuild": "node scripts/set-monaco-version.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.34",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/elements": "^20.3.34",
    "@angular/forms": "^20.3.34",
    "@angular/localize": "20.3.34",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.34",
    "@angular/platform-browser-dynamic": "^20.3.34",
    "@angular/router": "^20.3.34",
    "@angular/service-worker": "20.3.34",
    "@apollo/client": "^4.3.4",
    "@danielmoncada/angular-datetime-picker": "^21.0.0",
    "@danielmoncada/angular-datetime-picker-moment-adapter": "^8.0.0",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@ng-select/ng-select": "^20.7.0",
    "@popperjs/core": "^2.11.8",
    "@rxweb/reactive-form-validators": "^13.0.1",
    "@schematics/angular": "^20.3.40",
    "@swimlane/ngx-graph": "^13.0.0",
    "@types/file-saver": "^2.0.7",
    "angular2-multiselect-dropdown": "^10.0.0",
    "apollo-angular": "^14.2.0",
    "autoprefixer": "^10.6.1",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.2",
    "buffer": "^6.0.3",
    "clipboard": "^2.0.11",
    "cron-parser": "^5.10.2",
    "d3-scale": "^4.0.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "ethers": "^6.17.0",
    "file-saver": "^2.0.5",
    "graphql": "^16.14.2",
    "idb": "^8.0.4",
    "jwt-decode": "^4.0.0",
    "katex": "^0.16.47",
    "marked": "^16.4.2",
    "monaco-editor": "^0.52.2",
    "ng-multiselect-dropdown": "^1.0.0",
    "ng2-pdf-viewer": "^9.1.5",
    "ngx-highlightjs": "^14.0.1",
    "ngx-infinite-scroll": "^20.0.0",
    "ngx-markdown": "^20.1.0",
    "ngx-monaco-editor-v2": "^20.3.0",
    "ngx-toastr": "^19.1.0",
    "ngx-trim-directive": "^3.0.1",
    "pdfjs-dist": "^2.16.105",
    "rxjs": "^7.8.1",
    "siwe": "^3.0.0",
    "tslib": "^2.0.0",
    "yaml": "^2.9.1",
    "zone.js": "^0.15.1"
  },
  "overrides": {
    "d3-selection": "3.0.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.40",
    "@angular/cli": "^20.3.40",
    "@angular/compiler-cli": "^20.3.34",
    "@angular/language-service": "^20.3.34",
    "@graphql-codegen/add": "^6.0.1",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/typescript-apollo-angular": "^4.0.1",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@metamask/providers": "^22.1.0",
    "@types/jasmine": "^4.3.6",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-license-header": "^0.9.0",
    "globals": "^17.13.0",
    "jasmine": "^5.5.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.3.0",
    "timekeeper": "^2.3.1",
    "ts-node": "~8.3.0",
    "typescript": "~5.9.3",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
